/*
  X-Content-Type-Options: nosniff
  # 0 بدل 1;mode=block: الترويسة مهجورة وقيم 1 قد تُفعّل فلتر IE القديم الذي
  # يُستغل لحقن ثغرات؛ التوصية الحديثة تعطيلها والاعتماد على CSP.
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN

# ===== Service Worker — لا يُخزّن أبداً =====
/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  CDN-Cache-Control: no-store
  Service-Worker-Allowed: /
  Pragma: no-cache

# ===== HTML — لا يُخزّن =====
/
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  CDN-Cache-Control: no-store
  Pragma: no-cache

/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  CDN-Cache-Control: no-store
  Pragma: no-cache

/404.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  CDN-Cache-Control: no-store
  Pragma: no-cache

# ===== Manifest — لا يُخزّن (للتحديثات) =====
/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  CDN-Cache-Control: no-store
  Pragma: no-cache

# ===== أصول ثابتة — خزّنها بشكل دائم (performance) =====
/icon.svg
  Content-Type: image/svg+xml; charset=utf-8
  Cache-Control: public, max-age=604800, s-maxage=604800, immutable

/apple-touch-icon.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800, s-maxage=604800, immutable

/*.png
  Cache-Control: public, max-age=604800, s-maxage=604800, immutable

/*.jpg
  Cache-Control: public, max-age=604800, s-maxage=604800, immutable

/*.webp
  Cache-Control: public, max-age=604800, s-maxage=604800, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

# ===== SEO files — خزّنها ساعة =====
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400

# ===== Digital Asset Links (Android TWA / Google Play) =====
# يجب أن يُقدَّم بمحتوى application/json عبر HTTPS من هذا المسار بالضبط.
# مدة تخزين قصيرة حتى تصل تغييرات البصمة بعد إعادة التوقيع بسرعة.
/.well-known/assetlinks.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=3600
  X-Content-Type-Options: nosniff

# ===== شاشات إقلاع iOS (مجلد splash) — خزّنها دائماً =====
/splash/*.png
  Cache-Control: public, max-age=604800, s-maxage=604800, immutable
